# ==============================================================================
# Kuchipudi Hasta Detection Platform — Environment Configuration Template
# Copy this file to '.env' inside the 'backend/' folder before starting the server.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# SQLite Database Connection (use absolute path on Windows if needed)
DATABASE_URL=sqlite:///./kuchipudi.db

# JWT Authentication Secret & Algorithm
# WARNING: Change this secret key in production deployments!
SECRET_KEY=kuchipudi-classical-dance-secret-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# AI Inference Engine Configuration
AI_WEIGHTS_PATH=deployment_clean/nritya_ai_weights.keras
AI_DEVICE=cpu
CONFIDENCE_THRESHOLD=0.70
